{
    "$schema": "https://github.com/unoforge/cli/tree/main/packages/core/schema-item.json",
    "version": "1.0.0",
    "name": "theme-default",
    "type": "registry:style",
    "title": "Default Theme",
    "description": "Default Flexiwind theme with balanced blue-purple tones",
    "message": "Theme \"default\" CSS variables have been applied to your entry CSS file.",
    "cssVars": {
        "light": {
            "--background": "hsl(0 0% 100%)",
            "--foreground": "oklch(37% 0.013 285.805)",
            "--title-foreground": "oklch(21% 0.006 285.885)",
            "--card": "hsl(0 0% 100%)",
            "--card-foreground": "oklch(21% 0.006 285.885)",
            "--popover": "hsl(0 0% 100%)",
            "--popover-foreground": "oklch(37% 0.013 285.805)",
            "--primary": "hsl(243 75% 59%)",
            "--primary-foreground": "hsl(0 0% 100%)",
            "--secondary": "hsl(187 92% 36%)",
            "--secondary-foreground": "hsl(0 0% 100%)",
            "--accent": "hsl(209 92% 36%)",
            "--accent-foreground": "hsl(0 0% 100%)",
            "--muted": "oklch(96.7% 0.001 286.375)",
            "--muted-foreground": "oklch(44.2% 0.017 285.786)",
            "--destructive": "oklch(57.7% 0.245 27.325)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "oklch(59.6% 0.145 163.225)",
            "--warning": "oklch(64.6% 0.222 41.116)",
            "--info": "oklch(58.8% 0.158 241.966)",
            "--border": "oklch(92% 0.004 286.32)",
            "--input": "oklch(92% 0.004 286.32)",
            "--ring": "var(--primary)",
            "--surface-background": "oklch(98.5% 0 none)",
            "--border-strong": "oklch(87.1% 0.006 286.286)",
            "--border-card": "var(--border)",
            "--border-input": "var(--input)",
            "--chart-1": "var(--primary)",
            "--chart-2": "var(--secondary)",
            "--chart-3": "var(--accent)",
            "--chart-4": "color-mix(in oklab, var(--primary) 70%, white)",
            "--chart-5": "color-mix(in oklab, var(--secondary) 70%, white)",
            "--gray-50": "oklch(98.5% 0 0)",
            "--gray-100": "oklch(96.7% 0.001 286.375)",
            "--gray-200": "oklch(92% 0.004 286.32)",
            "--gray-300": "oklch(87.1% 0.006 286.286)",
            "--gray-400": "oklch(70.5% 0.015 286.067)",
            "--gray-500": "oklch(55.2% 0.016 285.938)",
            "--gray-600": "oklch(44.2% 0.017 285.786)",
            "--gray-700": "oklch(37% 0.013 285.805)",
            "--gray-800": "oklch(27.4% 0.006 286.033)",
            "--gray-900": "oklch(21% 0.006 285.885)",
            "--gray-950": "oklch(14.1% 0.005 285.823)"
        },
        "dark": {
            "--background": "oklch(14.1% 0.005 285.823)",
            "--foreground": "oklch(87.1% 0.006 286.286)",
            "--title-foreground": "hsl(0 0% 100%)",
            "--card": "oklch(14.1% 0.005 285.823)",
            "--card-foreground": "hsl(0 0% 100%)",
            "--popover": "oklch(14.1% 0.005 285.823)",
            "--popover-foreground": "oklch(87.1% 0.006 286.286)",
            "--primary": "hsl(243 75% 59%)",
            "--primary-foreground": "hsl(0 0% 100%)",
            "--secondary": "hsl(187 92% 36%)",
            "--secondary-foreground": "hsl(0 0% 100%)",
            "--accent": "hsl(209 92% 36%)",
            "--accent-foreground": "hsl(0 0% 100%)",
            "--muted": "oklch(21% 0.006 285.885)",
            "--muted-foreground": "oklch(70.5% 0.015 286.067)",
            "--destructive": "oklch(57.7% 0.245 27.325)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "oklch(59.6% 0.145 163.225)",
            "--warning": "oklch(64.6% 0.222 41.116)",
            "--info": "oklch(58.8% 0.158 241.966)",
            "--border": "oklch(21% 0.006 285.885)",
            "--input": "oklch(27.4% 0.006 286.033)",
            "--ring": "var(--primary)",
            "--surface-background": "color-mix(in oklab, var(--muted) 70%, transparent)",
            "--border-strong": "oklch(37% 0.013 285.805)",
            "--border-card": "oklch(27.4% 0.006 286.033)",
            "--border-input": "var(--input)",
            "--chart-1": "var(--primary)",
            "--chart-2": "var(--secondary)",
            "--chart-3": "var(--accent)",
            "--chart-4": "color-mix(in oklab, var(--primary) 70%, white)",
            "--chart-5": "color-mix(in oklab, var(--secondary) 70%, white)"
        }
    }
}