{
    "$schema": "https://github.com/unoforge/cli/tree/main/packages/core/schema-item.json",
    "version": "1.0.0",
    "name": "theme-passion",
    "type": "registry:style",
    "title": "Passion Theme",
    "description": "Deep reds and passionate warm tones",
    "message": "Theme \"passion\" CSS variables have been applied to your entry CSS file.",
    "cssVars": {
        "light": {
            "--background": "hsl(0 0% 100%)",
            "--foreground": "oklch(37.1% 0 none)",
            "--title-foreground": "oklch(20.5% 0 none)",
            "--card": "hsl(0 0% 100%)",
            "--card-foreground": "oklch(20.5% 0 none)",
            "--popover": "hsl(0 0% 100%)",
            "--popover-foreground": "oklch(37.1% 0 none)",
            "--primary": "oklch(57.7% 0.245 27.325)",
            "--primary-foreground": "hsl(0 0% 100%)",
            "--secondary": "oklch(64.6% 0.222 41.116)",
            "--secondary-foreground": "hsl(0 0% 100%)",
            "--accent": "oklch(66.6% 0.179 58.318)",
            "--accent-foreground": "hsl(0 0% 100%)",
            "--muted": "oklch(97% 0 none)",
            "--muted-foreground": "oklch(43.9% 0 none)",
            "--destructive": "oklch(57.7% 0.245 27.325)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "oklch(59.6% 0.145 163.225)",
            "--warning": "oklch(64.6% 0.222 41.116)",
            "--info": "oklch(58.8% 0.158 241.966)",
            "--border": "oklch(92.2% 0 none)",
            "--input": "oklch(92.2% 0 none)",
            "--ring": "var(--primary)",
            "--surface-background": "oklch(98.5% 0 none)",
            "--border-strong": "oklch(87% 0 none)",
            "--border-card": "var(--border)",
            "--border-input": "var(--input)",
            "--chart-1": "var(--primary)",
            "--chart-2": "var(--secondary)",
            "--chart-3": "var(--accent)",
            "--chart-4": "color-mix(in oklab, var(--primary) 70%, white)",
            "--chart-5": "color-mix(in oklab, var(--secondary) 70%, white)",
            "--gray-50": "hsl(0 12% 98%)",
            "--gray-100": "hsl(0 10% 95%)",
            "--gray-200": "hsl(5 8% 89%)",
            "--gray-300": "hsl(5 7% 82%)",
            "--gray-400": "hsl(5 5% 64%)",
            "--gray-500": "hsl(5 4% 45%)",
            "--gray-600": "hsl(5 5% 33%)",
            "--gray-700": "hsl(5 7% 25%)",
            "--gray-800": "hsl(5 9% 15%)",
            "--gray-900": "hsl(0 11% 10%)",
            "--gray-950": "hsl(0 14% 4%)"
        },
        "dark": {
            "--background": "oklch(14.5% 0 none)",
            "--foreground": "oklch(87% 0 none)",
            "--title-foreground": "hsl(0 0% 100%)",
            "--card": "oklch(14.5% 0 none)",
            "--card-foreground": "hsl(0 0% 100%)",
            "--popover": "oklch(14.5% 0 none)",
            "--popover-foreground": "oklch(87% 0 none)",
            "--primary": "oklch(57.7% 0.245 27.325)",
            "--primary-foreground": "hsl(0 0% 100%)",
            "--secondary": "oklch(64.6% 0.222 41.116)",
            "--secondary-foreground": "hsl(0 0% 100%)",
            "--accent": "oklch(66.6% 0.179 58.318)",
            "--accent-foreground": "hsl(0 0% 100%)",
            "--muted": "oklch(20.5% 0 none)",
            "--muted-foreground": "oklch(70.8% 0 none)",
            "--destructive": "oklch(57.7% 0.245 27.325)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "oklch(59.6% 0.145 163.225)",
            "--warning": "oklch(64.6% 0.222 41.116)",
            "--info": "oklch(58.8% 0.158 241.966)",
            "--border": "oklch(20.5% 0 none)",
            "--input": "oklch(26.9% 0 none)",
            "--ring": "var(--primary)",
            "--surface-background": "color-mix(in oklab, var(--muted) 70%, transparent)",
            "--border-strong": "oklch(37.1% 0 none)",
            "--border-card": "oklch(26.9% 0 none)",
            "--border-input": "var(--input)",
            "--chart-1": "var(--primary)",
            "--chart-2": "var(--secondary)",
            "--chart-3": "var(--accent)",
            "--chart-4": "color-mix(in oklab, var(--primary) 70%, white)",
            "--chart-5": "color-mix(in oklab, var(--secondary) 70%, white)"
        }
    }
}