{
    "$schema": "https://github.com/unoforge/cli/tree/main/packages/core/schema-item.json",
    "version": "1.0.0",
    "name": "icon",
    "type": "registry:component",
    "title": "Icon",
    "description": "A reusable icon component for Laravel Blade/Livewire using Iconify.",
    "files": [
        {
            "path": "resources/views/components/ui/icon.blade.php",
            "type": "registry:ui",
            "target": "resources/views/components/ui/icon.blade.php",
            "content": "@props(['name', 'size' => 'sm', 'intent' => 'current', 'class' => '', 'iconSlot' => 'icon', 'dataSlot' => 'icon'])\n\n@php\n    $sizeClasses = [\n        'xs' => 'size-3.5',\n        'sm' => 'size-4',\n        'md' => 'size-5',\n        'lg' => 'size-6.5',\n        'xl' => 'size-7.5',\n        '2xl' => 'size-9',\n    ];\n\n    $sizeClass = $size ? $sizeClasses[$size] ?? $sizeClasses['md'] : '';\n\n    $intentClasses = [\n        'current'=>'text-current',\n        'fg' => 'text-foreground',\n        'muted' => 'text-muted-foreground',\n        'primary' => 'text-primary',\n        'secondary' => 'text-secondary',\n        'success' => 'text-success',\n        'warning' => 'text-warning',\n        'danger' => 'text-destructive',\n        'destructive' => 'text-destructive',\n    ];\n\n    $intentClass = $intent ? $intentClasses[$intent] ?? '' : '';\n@endphp\n\n<span\n    @if ($iconSlot) slot=\"{{ $iconSlot }}\" @endif\n    @if ($dataSlot) data-slot=\"{{ $dataSlot }}\" @endif\n    aria-hidden=\"true\"\n    {{ $attributes->class(['flex iconify', $name, $sizeClass, $intentClass, $class]) }}\n></span>\n"
        }
    ]
}