{
    "name": "unoforge/flexiwind",
    "description": "Flexiwind — composants et blocks gratuits, contenu de la documentation, et moteur de docs Markdown.",
    "type": "library",
    "license": "MIT",
    "authors": [{ "name": "Johnkat MJ" }],
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "league/commonmark": "^2.4"
    },
    "autoload": {
        "psr-4": { "Flexiwind\\": "src/" }
    },
    "extra": {
        "laravel": {
            "providers": ["Flexiwind\\FlexiwindServiceProvider"]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
