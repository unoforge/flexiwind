{
    "$schema": "https://github.com/unoforge/cli/tree/main/packages/core/schema-item.json",
    "version": "1.0.0",
    "name": "theme-mono",
    "type": "registry:style",
    "title": "Mono Theme",
    "description": "Black and white, no accent color",
    "message": "Theme \"mono\" CSS variables have been applied to your entry CSS file.",
    "cssVars": {
        "light": {
            "--background": "#ffffff",
            "--foreground": "#3f3f46",
            "--title-foreground": "#18181b",
            "--card": "#ffffff",
            "--card-foreground": "#18181b",
            "--popover": "#ffffff",
            "--popover-foreground": "#3f3f46",
            "--primary": "#18181b",
            "--primary-foreground": "#ffffff",
            "--secondary": "#3f3f46",
            "--secondary-foreground": "#ffffff",
            "--accent": "#3f3f46",
            "--accent-foreground": "#ffffff",
            "--muted": "#f4f4f5",
            "--muted-foreground": "#52525b",
            "--destructive": "hsl(0 72% 51%)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "hsl(161 94% 30%)",
            "--warning": "hsl(21 90% 48%)",
            "--info": "hsl(200 98% 39%)",
            "--border": "#e4e4e7",
            "--input": "#e4e4e7",
            "--ring": "var(--primary)",
            "--surface-background": "#fafafa",
            "--border-strong": "#d4d4d8",
            "--border-card": "var(--border)",
            "--border-input": "var(--input)",
            "--chart-1": "#18181b",
            "--chart-2": "#eb6834",
            "--chart-3": "#1baf7a",
            "--chart-4": "#eda100",
            "--chart-5": "#e87ba4",
            "--gray-50": "#fafafa",
            "--gray-100": "#f4f4f5",
            "--gray-200": "#e4e4e7",
            "--gray-300": "#d4d4d8",
            "--gray-400": "#a1a1aa",
            "--gray-500": "#71717a",
            "--gray-600": "#52525b",
            "--gray-700": "#3f3f46",
            "--gray-800": "#27272a",
            "--gray-900": "#18181b",
            "--gray-950": "#09090b",
            "--checkbox-mark-color": "var(--primary-foreground)",
            "--ui-select-indicator-color": "var(--muted-foreground)",
            "--ui-checkbox-invalid-color": "var(--destructive)",
            "--switch-knob-checked-color": "var(--primary-foreground)"
        },
        "dark": {
            "--background": "#09090b",
            "--foreground": "#d4d4d8",
            "--title-foreground": "#ffffff",
            "--card": "#09090b",
            "--card-foreground": "#ffffff",
            "--popover": "#09090b",
            "--popover-foreground": "#d4d4d8",
            "--primary": "#fafafa",
            "--primary-foreground": "#09090b",
            "--secondary": "#71717a",
            "--secondary-foreground": "#09090b",
            "--accent": "#d4d4d8",
            "--accent-foreground": "#09090b",
            "--muted": "#18181b",
            "--muted-foreground": "#a1a1aa",
            "--destructive": "hsl(0 84% 60%)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "hsl(160 84% 39%)",
            "--warning": "hsl(25 95% 53%)",
            "--info": "hsl(199 89% 48%)",
            "--border": "#18181b",
            "--input": "#27272a",
            "--ring": "var(--primary)",
            "--surface-background": "color-mix(in oklab, #18181b 60%, #09090b)",
            "--border-strong": "#3f3f46",
            "--border-card": "oklch(27.4% 0.006 286.033)",
            "--border-input": "var(--input)",
            "--chart-1": "#fafafa",
            "--chart-2": "#d95926",
            "--chart-3": "#199e70",
            "--chart-4": "#c98500",
            "--chart-5": "#d55181",
            "--checkbox-mark-color": "var(--primary-foreground)",
            "--ui-select-indicator-color": "var(--muted-foreground)",
            "--ui-checkbox-invalid-color": "var(--destructive)",
            "--switch-knob-checked-color": "var(--primary-foreground)"
        }
    }
}