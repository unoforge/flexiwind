{
    "$schema": "https://github.com/unoforge/cli/tree/main/packages/core/schema-item.json",
    "version": "1.0.0",
    "name": "theme-orange",
    "type": "registry:style",
    "title": "Orange Theme",
    "description": "Bright orange on true neutral grays",
    "message": "Theme \"orange\" CSS variables have been applied to your entry CSS file.",
    "cssVars": {
        "light": {
            "--background": "#ffffff",
            "--foreground": "#404040",
            "--title-foreground": "#171717",
            "--card": "#ffffff",
            "--card-foreground": "#171717",
            "--popover": "#ffffff",
            "--popover-foreground": "#404040",
            "--primary": "#ea580c",
            "--primary-foreground": "#ffffff",
            "--secondary": "#d97706",
            "--secondary-foreground": "#ffffff",
            "--accent": "#f97316",
            "--accent-foreground": "#ffffff",
            "--muted": "#f5f5f5",
            "--muted-foreground": "#525252",
            "--destructive": "hsl(0 72% 51%)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "hsl(161 94% 30%)",
            "--warning": "hsl(21 90% 48%)",
            "--info": "hsl(200 98% 39%)",
            "--border": "#e5e5e5",
            "--input": "#e5e5e5",
            "--ring": "var(--primary)",
            "--surface-background": "#fafafa",
            "--border-strong": "#d4d4d4",
            "--border-card": "var(--border)",
            "--border-input": "var(--input)",
            "--chart-1": "#ea580c",
            "--chart-2": "#eb6834",
            "--chart-3": "#1baf7a",
            "--chart-4": "#eda100",
            "--chart-5": "#e87ba4",
            "--gray-50": "#fafafa",
            "--gray-100": "#f5f5f5",
            "--gray-200": "#e5e5e5",
            "--gray-300": "#d4d4d4",
            "--gray-400": "#a3a3a3",
            "--gray-500": "#737373",
            "--gray-600": "#525252",
            "--gray-700": "#404040",
            "--gray-800": "#262626",
            "--gray-900": "#171717",
            "--gray-950": "#0a0a0a",
            "--checkbox-mark-color": "var(--primary-foreground)",
            "--ui-select-indicator-color": "var(--muted-foreground)",
            "--ui-checkbox-invalid-color": "var(--destructive)",
            "--switch-knob-checked-color": "var(--primary-foreground)"
        },
        "dark": {
            "--background": "#0a0a0a",
            "--foreground": "#d4d4d4",
            "--title-foreground": "#ffffff",
            "--card": "#0a0a0a",
            "--card-foreground": "#ffffff",
            "--popover": "#0a0a0a",
            "--popover-foreground": "#d4d4d4",
            "--primary": "#f97316",
            "--primary-foreground": "#ffffff",
            "--secondary": "#f59e0b",
            "--secondary-foreground": "#ffffff",
            "--accent": "#f97316",
            "--accent-foreground": "#ffffff",
            "--muted": "#171717",
            "--muted-foreground": "#a3a3a3",
            "--destructive": "hsl(0 84% 60%)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "hsl(160 84% 39%)",
            "--warning": "hsl(25 95% 53%)",
            "--info": "hsl(199 89% 48%)",
            "--border": "#171717",
            "--input": "#262626",
            "--ring": "var(--primary)",
            "--surface-background": "color-mix(in oklab, #171717 60%, #0a0a0a)",
            "--border-strong": "#404040",
            "--border-card": "oklch(27.4% 0.006 286.033)",
            "--border-input": "var(--input)",
            "--chart-1": "#f97316",
            "--chart-2": "#d95926",
            "--chart-3": "#199e70",
            "--chart-4": "#c98500",
            "--chart-5": "#d55181",
            "--checkbox-mark-color": "var(--primary-foreground)",
            "--ui-select-indicator-color": "var(--muted-foreground)",
            "--ui-checkbox-invalid-color": "var(--destructive)",
            "--switch-knob-checked-color": "var(--primary-foreground)"
        }
    }
}