            "--border-input": "var(--input)",
            "--chart-1": "#4f46e5",
            "--chart-2": "#eb6834",
            "--chart-3": "#1baf7a",
            "--chart-4": "#eda100",
            "--chart-5": "#e87ba4",
            "--gray-50": "#f8fafc",
            "--gray-100": "#f1f5f9",
            "--gray-200": "#e2e8f0",
            "--gray-300": "#cbd5e1",
            "--gray-400": "#94a3b8",
            "--gray-500": "#64748b",
            "--gray-600": "#475569",
            "--gray-700": "#334155",
            "--gray-800": "#1e293b",
            "--gray-900": "#0f172a",
            "--gray-950": "#020617",
            "--checkbox-mark-color": "var(--primary-foreground)",
            "--ui-select-indicator-color": "var(--muted-foreground)",
            "--ui-checkbox-invalid-color": "var(--destructive)",
            "--switch-knob-checked-color": "var(--primary-foreground)"
        },
        "dark": {
            "--background": "#020617",
            "--foreground": "#cbd5e1",
            "--title-foreground": "#ffffff",
            "--card": "#020617",
            "--card-foreground": "#ffffff",
            "--popover": "#020617",
            "--popover-foreground": "#cbd5e1",
            "--primary": "#6366f1",
