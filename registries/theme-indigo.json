{
    "$schema": "https://github.com/unoforge/cli/tree/main/packages/core/schema-item.json",
    "version": "1.0.0",
    "name": "theme-indigo",
    "type": "registry:style",
    "title": "Indigo Theme",
    "description": "Deep indigo on cool slate grays",
    "message": "Theme \"indigo\" CSS variables have been applied to your entry CSS file.",
    "cssVars": {
        "light": {
            "--background": "#ffffff",
            "--foreground": "#334155",
            "--title-foreground": "#0f172a",
            "--card": "#ffffff",
            "--card-foreground": "#0f172a",
            "--popover": "#ffffff",
            "--popover-foreground": "#334155",
            "--primary": "#4f46e5",
            "--primary-foreground": "#ffffff",
            "--secondary": "#7c3aed",
            "--secondary-foreground": "#ffffff",
            "--accent": "#6366f1",
            "--accent-foreground": "#ffffff",
            "--muted": "#f1f5f9",
            "--muted-foreground": "#475569",
            "--destructive": "hsl(0 72% 51%)",
            "--destructive-foreground": "hsl(0 0% 100%)",
            "--success": "hsl(161 94% 30%)",
            "--warning": "hsl(21 90% 48%)",
            "--info": "hsl(200 98% 39%)",
            "--border": "#e2e8f0",
            "--input": "#e2e8f0",
            "--ring": "var(--primary)",
            "--surface-background": "#f8fafc",
            "--border-strong": "#cbd5e1",
